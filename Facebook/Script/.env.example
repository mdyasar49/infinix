# Copy to Script/.env and fill in values.
# Do NOT commit real credentials.

# Same Google Sheet every day (spreadsheet ID from the sheet URL)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Facebook Leads
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json

# Optional Facebook login
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# Daily scrape batch size
DAILY_SCRAPE_LIMIT=25

# CRM sheet defaults
LEAD_SOURCE=Facebook
LEAD_STATUS=New
LEAD_ADDED_BY=Facebook Scraper

# Only push pages created within this many months
# 0 = no age limit
MAX_ACCOUNT_AGE_MONTHS=0
# Email AND phone/mobile mandatory for sheet rows
REQUIRE_EMAIL_AND_PHONE=true
REQUIRE_AUSTRALIA=true

# Set true to scrape without pushing to Google Sheets
SKIP_GOOGLE_SHEETS=false

# Optional fixed ChromeDriver path
# CHROMEDRIVER_PATH=
